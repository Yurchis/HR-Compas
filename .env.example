# Скопіюйте у .env і заповніть:  cp .env.example .env
# .env НЕ комітиться (див. .gitignore)

# Хмарний провайдер (залиште потрібний)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Локальна модель (напр. Ollama)
OLLAMA_BASE_URL=http://localhost:11434

# OpenRouter: лише ключ. Усі інші налаштування — у config/settings.toml
OPENROUTER_API_KEY=
