# Copy to .env and fill in:  cp .env.example .env
# .env is NOT committed (see .gitignore)

# Cloud provider (keep the one you need)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Local model (e.g. Ollama)
OLLAMA_BASE_URL=http://localhost:11434

# OpenRouter: only the key. All other settings are in config/settings.toml
OPENROUTER_API_KEY=
