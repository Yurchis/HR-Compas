# Golden set: one JSON object per line. Required: id, question.
# Optional: expected_answer, expected_keywords, country, sub_company, expected_kind.
# country / sub_company — the employee profile known to the bot in advance (as in the chat after a clarification);
#   missing = unknown.
# expected_kind — the expected reply type: answer | clarification | out_of_scope (checked by evaluate, the
#   "Reply type" column). Without the field the type is not checked.
# 10 questions x 3 countries (USA / UA / Costa Rica) = 30, expected_kind = answer. The same question with a different
#   profile: ids qNN-usa / qNN-ua / qNN-cr. The Costa Rica set is a test set (built from the UA handbook, 10 parameters
#   changed).
# qNN-any — the same 10 questions without a profile: every rule in the handbook depends on the country, so the bot
#   must not answer but ask for the country (expected_kind = clarification, no keywords).
# expected_keywords — case-insensitive substrings; "HR" = a refusal referring to HR is expected (the country's
#   handbook has no answer).
# q01 and q07 are asked in Ukrainian on purpose (their expected answers are in Ukrainian too): they test that the
#   bot answers in the language of the question.
{"id": "q01-usa", "question": "Скільки днів оплачуваної відпустки на рік я маю?", "country": "USA", "sub_company": "IT-Outsourcing", "expected_answer": "Відпустка рахується в годинах: 80 годин (0–3 роки стажу), 120 (3–5 років), 160 (5+ років); part-time — 40 годин.", "expected_keywords": ["80"], "expected_kind": "answer"}
{"id": "q01-ua", "question": "Скільки днів оплачуваної відпустки на рік я маю?", "country": "UA", "sub_company": "IT-Product", "expected_answer": "24 календарні дні після 6 місяців безперервної роботи; до того — пропорційно відпрацьованому часу.", "expected_keywords": ["24"], "expected_kind": "answer"}
{"id": "q01-cr", "question": "Скільки днів оплачуваної відпустки на рік я маю?", "country": "Costa Rica", "sub_company": "IT-Outsourcing", "expected_answer": "18 календарних днів після 50 тижнів безперервної роботи; до того — пропорційно відпрацьованому часу.", "expected_keywords": ["18"], "expected_kind": "answer"}
{"id": "q02-usa", "question": "How long do I have to work before I am entitled to paid vacation?", "country": "USA", "sub_company": "IT-Outsourcing", "expected_answer": "New employees can use vacation after 60 days of employment.", "expected_keywords": ["60"], "expected_kind": "answer"}
{"id": "q02-ua", "question": "How long do I have to work before I am entitled to paid vacation?", "country": "UA", "sub_company": "IT-Product", "expected_answer": "The full 24 days after 6 months of continuous employment; before that a pro-rated vacation (some categories get the full leave earlier).", "expected_keywords": ["6"], "expected_kind": "answer"}
{"id": "q02-cr", "question": "How long do I have to work before I am entitled to paid vacation?", "country": "Costa Rica", "sub_company": "IT-Outsourcing", "expected_answer": "The full 18 days after 50 weeks of continuous employment; before that a pro-rated vacation (some categories get the full leave earlier).", "expected_keywords": ["50"], "expected_kind": "answer"}
{"id": "q03-usa", "question": "What is the minimum amount of vacation I can take at once?", "country": "USA", "sub_company": "IT-Outsourcing", "expected_answer": "Vacation may be used in minimum 4-hour increments.", "expected_keywords": ["4", "hour"], "expected_kind": "answer"}
{"id": "q03-ua", "question": "What is the minimum amount of vacation I can take at once?", "country": "UA", "sub_company": "IT-Product", "expected_answer": "The main part must be at least 14 calendar days, the rest in minimum 3-day increments; during martial law vacation can be taken in 1-day increments.", "expected_keywords": ["martial"], "expected_kind": "answer"}
{"id": "q03-cr", "question": "What is the minimum amount of vacation I can take at once?", "country": "Costa Rica", "sub_company": "IT-Outsourcing", "expected_answer": "The main part must be at least 14 calendar days, the rest in minimum 3-day increments (no martial-law exception).", "expected_keywords": ["14", "3"], "expected_kind": "answer"}
{"id": "q04-usa", "question": "Which public holidays does the company observe?", "country": "USA", "sub_company": "IT-Outsourcing", "expected_answer": "New Year's Day, Memorial Day, Independence Day, Labor Day, Thanksgiving Day, Christmas Day.", "expected_keywords": ["Thanksgiving"], "expected_kind": "answer"}
{"id": "q04-ua", "question": "Which public holidays does the company observe?", "country": "UA", "sub_company": "IT-Product", "expected_answer": "Six US holidays (New Year, Memorial Day, Independence Day, Labor Day, Thanksgiving, Christmas) plus 5 floating days for Ukrainian public holidays.", "expected_keywords": ["Thanksgiving"], "expected_kind": "answer"}
{"id": "q04-cr", "question": "Which public holidays does the company observe?", "country": "Costa Rica", "sub_company": "IT-Outsourcing", "expected_answer": "New Year's Day, Juan Santamaría Day, Labour Day, Guanacaste Day, Independence Day (September 15), Christmas Day.", "expected_keywords": ["Guanacaste"], "expected_kind": "answer"}
{"id": "q05-usa", "question": "How many floating holidays do I get?", "country": "USA", "sub_company": "IT-Outsourcing", "expected_answer": "Not covered by the handbook; the bot should say it does not know and refer to HR.", "expected_keywords": ["HR"], "expected_kind": "answer"}
{"id": "q05-ua", "question": "How many floating holidays do I get?", "country": "UA", "sub_company": "IT-Product", "expected_answer": "5 floating holidays for Ukrainian public holidays; no more than 1 per 30 days, 4 days' notice.", "expected_keywords": ["5"], "expected_kind": "answer"}
{"id": "q05-cr", "question": "How many floating holidays do I get?", "country": "Costa Rica", "sub_company": "IT-Outsourcing", "expected_answer": "7 floating holidays; no more than 1 per 30 days, 4 days' notice.", "expected_keywords": ["7"], "expected_kind": "answer"}
{"id": "q06-usa", "question": "How is sick leave paid?", "country": "USA", "sub_company": "IT-Outsourcing", "expected_answer": "Employees working in New York City get 40 hours of paid safe and sick time per calendar year, paid at their regular rate; longer off-the-job illness — statutory short-term disability, 50% of average wages up to $170 a week from the 8th day.", "expected_keywords": ["40"], "expected_kind": "answer"}
{"id": "q06-ua", "question": "How is sick leave paid?", "country": "UA", "sub_company": "IT-Product", "expected_answer": "Up to 4 months with a medical certificate; the first 5 days are paid by the employer, the rest by the Social Insurance Fund at 50–100% of average salary depending on seniority.", "expected_keywords": ["5", "Social Insurance"], "expected_kind": "answer"}
{"id": "q06-cr", "question": "How is sick leave paid?", "country": "Costa Rica", "sub_company": "IT-Outsourcing", "expected_answer": "For the first 3 days the employer pays 50% of salary; from the 4th day the CCSS pays 60% of average salary.", "expected_keywords": ["CCSS", "60"], "expected_kind": "answer"}
{"id": "q07-usa", "question": "Скільки триває декретна відпустка і як вона оплачується?", "country": "USA", "sub_company": "IT-Outsourcing", "expected_answer": "Statutory short-term disability: 6 тижнів після звичайних пологів (8 — після кесаревого), 50% середньої зарплати, до $170 на тиждень; плюс до 12 тижнів Paid Family Leave для догляду за дитиною (67% зарплати).", "expected_keywords": ["6", "8"], "expected_kind": "answer"}
{"id": "q07-ua", "question": "Скільки триває декретна відпустка і як вона оплачується?", "country": "UA", "sub_company": "IT-Product", "expected_answer": "126 календарних днів (70 до пологів і 56 після), 100% середньої зарплати від Фонду соціального страхування.", "expected_keywords": ["126"], "expected_kind": "answer"}
{"id": "q07-cr", "question": "Скільки триває декретна відпустка і як вона оплачується?", "country": "Costa Rica", "sub_company": "IT-Outsourcing", "expected_answer": "4 місяці: 1 до пологів і 3 після; 100% зарплати — 50% платить роботодавець і 50% CCSS.", "expected_keywords": ["4", "CCSS"], "expected_kind": "answer"}
{"id": "q08-usa", "question": "How many days of paternity leave do fathers get, and is it paid?", "country": "USA", "sub_company": "IT-Outsourcing", "expected_answer": "No separate paternity leave; Paid Family Leave gives up to 12 weeks to bond with a child, paid at 67% of the average weekly wage.", "expected_keywords": ["12", "67"], "expected_kind": "answer"}
